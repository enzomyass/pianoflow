{
  "appId": "com.rixon.pianoflow",
  "appName": "PianoFlow",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "BluetoothLe": {
      "displayStrings": {
        "scanning": "Searching for your piano…",
        "cancel": "Cancel",
        "availableDevices": "Bluetooth MIDI pianos",
        "noDeviceFound": "No Bluetooth MIDI piano found"
      }
    }
  }
}
